			"type": "api",
			"access": 3,
			"file": "vendor/Opus/apps/profile/src/EditProfileApi.php",
			"class": "Opus\\apps\\profile\\src\\EditProfileApi"
		},
		"changePassword": {
			"type": "api",
			"access": 3,
			"file": "vendor/Opus/apps/profile/src/ChangePasswordApi.php",
			"class": "Opus\\apps\\profile\\src\\ChangePasswordApi"
		}
	}
}
